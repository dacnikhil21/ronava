# ==============================================================================
# RONAV TECHNOLOGIES — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and configure your secure deployment values.
# NEVER commit the active .env file to version control.
# ==============================================================================

# Server Configuration
PORT=5000

# Authentication & Cryptographic Security
# NOTE: JWT_SECRET MUST be a cryptographically secure random string of AT LEAST 32 characters.
# The server will refuse to boot if this is missing or shorter than 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-cryptographically-random-string-at-least-32-chars-long

# Webhook Auto-Deploy Security
# Secret required to trigger POST /api/system/webhook-deploy
WEBHOOK_DEPLOY_SECRET=replace-with-a-secure-random-webhook-secret-here

# Token Lifetimes (in seconds)
# Admin default: 172800 (2 days)
ADMIN_TOKEN_EXPIRY_SECONDS=172800
# All other roles default: 2592000 (30 days)
USER_TOKEN_EXPIRY_SECONDS=2592000

# PostgreSQL Relational Database
DATABASE_URL=postgres://username:password@localhost:5432/ronav_db
PG_SSL=false

# AWS S3 Storage & CloudFront CDN
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_CLOUDFRONT_DOMAIN=your-cloudfront-domain.net
VITE_CLOUDFRONT_URL=https://your-cloudfront-domain.net
